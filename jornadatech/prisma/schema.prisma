generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Mantenha em sincronia com STEPS em lib/journey.ts.
enum JourneyStep {
  SELF
  FIELD_INTEREST
  SELF_EVALUATION
  CANVAS
  ACTION_PLAN
  DONE
}

enum GoalHorizon {
  SHORT
  MEDIUM
}

model User {
  /// Mesmo id de auth.users no Supabase.
  id              String      @id @db.Uuid
  email           String      @unique
  currentStep     JourneyStep @default(SELF)
  completedAt     DateTime?
  /// Id do perfil em lib/career/catalog.ts.
  targetProfileId String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  selfProfile SelfProfile?
  assessments SkillAssessment[]
  canvas      CareerCanvas?
  goals       ActionGoal[]
  feedback    JourneyFeedback?
  raffleEntry RaffleEntry?
}

model SelfProfile {
  userId      String   @id @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  semester    String
  motivation  String
  curiosities String[]
  updatedAt   DateTime @updatedAt
}

model SkillAssessment {
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Id da competência em lib/career/catalog.ts.
  skillId   String
  /// 0 a 5.
  level     Int
  updatedAt DateTime @updatedAt

  @@id([userId, skillId])
}

model CareerCanvas {
  userId          String   @id @db.Uuid
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  objective       String
  /// Lista final do aluno (editável, aceita itens livres).
  skillsToDevelop String[]
  /// Ids da trilha sugerida no momento em que o canvas foi salvo.
  suggestedSkills String[]
  networking      String
  experiences     String
  portfolio       String
  updatedAt       DateTime @updatedAt
}

model ActionGoal {
  id        String      @id @default(cuid())
  userId    String      @db.Uuid
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  position  Int
  horizon   GoalHorizon
  objective String
  action    String
  deadline  String
  indicator String
  done      Boolean     @default(false)
  suggested Boolean     @default(false)
  createdAt DateTime    @default(now())

  @@index([userId])
}

enum FeedbackFit {
  YES
  PARTIAL
  NO
}

/// Etapa mais difícil apontada no feedback; NONE = nenhuma.
enum FeedbackStep {
  SELF
  FIELD_INTEREST
  SELF_EVALUATION
  CANVAS
  ACTION_PLAN
  NONE
}

/// Questionário obrigatório na primeira conclusão. As colunas são opcionais
/// porque registros anteriores ao questionário atual não têm todas as respostas.
model JourneyFeedback {
  userId         String        @id @db.Uuid
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  nextAction     String
  /// 1 a 5.
  satisfaction   Int?
  /// Clareza do próximo passo na carreira, 1 a 5.
  clarity        Int?
  /// As competências a desenvolver sugeridas fazem sentido?
  suggestionsFit FeedbackFit?
  hardestStep    FeedbackStep?
  /// Recomendaria a um colega? 0 a 10.
  recommend      Int?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @default(now()) @updatedAt
}

/// Participação no sorteio do Evento Conexão, criada ao concluir a jornada.
model RaffleEntry {
  userId      String    @id @db.Uuid
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Código de 4 dígitos enviado por email, único entre participantes.
  code        String    @unique @db.Char(4)
  /// Preenchido quando o email com o código é enviado.
  emailSentAt DateTime?
  createdAt   DateTime  @default(now())
}
