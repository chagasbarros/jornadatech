# Postgres (Supabase)
# Pooled (transaction mode, porta 6543) — usada pela aplicação em runtime
DATABASE_URL="postgresql://user:password@host:6543/postgres?sslmode=require"
# Conexão direta ou session pooler (porta 5432) — usada só pelo Prisma Migrate
DIRECT_URL="postgresql://user:password@host:5432/postgres?sslmode=require"

# Supabase Auth (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL="https://<projeto>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-key>"

# O envio do código por email é feito pelo Supabase. Configure o SMTP
# em Authentication → Emails → SMTP Settings, no painel do Supabase.
